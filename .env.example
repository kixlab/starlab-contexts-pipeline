# Export only the credentials needed by your chosen model provider.
# This file is documentation; the Python CLI reads the process environment.
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional external storage directory. Relative paths resolve from the current directory.
# CIM_STORAGE_DIR=/path/to/local/cim-data
# Optional private task definitions (e.g. task_rep/data/local-tasks.json).
# CIM_TASKS_FILE=/path/to/local/tasks.json
# Optional downloader authentication, stored outside the repository.
# YT_DLP_COOKIES_FILE=/path/to/local/cookies.txt
# YT_DLP_COOKIES_FROM_BROWSER=firefox
