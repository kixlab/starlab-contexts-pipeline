# Copy an exported bundle to public/data/local-bundle.json before using this file.
# Never put API keys in NEXT_PUBLIC_* variables: these are sent to the browser.
NEXT_PUBLIC_BUNDLE_URL=/data/local-bundle.json
NEXT_PUBLIC_DATASET_LABEL=My tutorials
# Optional additional datasets (JSON array; each label must be unique):
# NEXT_PUBLIC_DATASETS='[{"label":"Another corpus","bundleUrl":"/data/local-other.json"}]'
